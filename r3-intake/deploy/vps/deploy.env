# Deployment manifest for r3-intake.
# Keep this file in git: it contains only non-secret deployment metadata.

# Unique app name; becomes the systemd service name and /srv/go-apps/<name> folder.
VPS_APP_NAME=r3-intake

# Public domain Traefik will route to this app.
# TODO: replace with the real domain before deploying.
VPS_APP_DOMAIN=r3.aipono.org

# Local port the Go app binds to (must be unique per VPS).
VPS_APP_PORT=8090

# Prefix used in the runtime .env file (the r3-intake binary reads R3_* vars).
VPS_ENV_PREFIX=R3

# Name of the compiled binary. Must match the Makefile output.
VPS_BINARY_NAME=r3-intake

# Subcommand passed to the binary.
VPS_BINARY_CMD=serve

# Go build target.
VPS_BUILD_TARGET=./cmd/r3-intake

# Traefik entrypoint and cert resolver.
VPS_TRAEFIK_ENTRYPOINT=websecure
VPS_TRAEFIK_CERTRESOLVER=letsencrypt

# Health check path used after restart.
VPS_HEALTH_PATH=/
