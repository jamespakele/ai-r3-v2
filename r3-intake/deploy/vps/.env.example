# R3 Intake — production environment file
# Copy to deploy/vps/.env, fill in real values, and never commit it.
# All values are read by the r3-intake binary via os.Getenv.

# -----------------------------------------------------------------------------
# MANDATORY — change these before exposing the app to the internet.
# -----------------------------------------------------------------------------

# Strong random key for signing session cookies. Generate with:
#   openssl rand -hex 32
R3_SESSION_KEY=REPLACE_WITH_64_HEX_CHARS

# PocketBase superuser for the /_/ admin UI. Only used when R3_ADMIN=1.
R3_PB_ADMIN_EMAIL=admin@r3.aipono.org
R3_PB_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# App login for the custom /admin dashboard.
R3_SEED_ADMIN_EMAIL=admin@r3.aipono.org
R3_SEED_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
R3_SEED_ADMIN_NAME="R3 Admin"

# -----------------------------------------------------------------------------
# MANDATORY — persistent data directory.
# -----------------------------------------------------------------------------
R3_DATA_DIR=/srv/go-apps/r3-intake/data

# -----------------------------------------------------------------------------
# Network / Traefik
# -----------------------------------------------------------------------------

# Bind to localhost only; Traefik will forward traffic to this port.
R3_HTTP_ADDR=127.0.0.1:8090

# PocketBase internal listener (not exposed publicly).
R3_PB_INTERNAL_ADDR=127.0.0.1:8091

# -----------------------------------------------------------------------------
# OPTIONAL — review and adjust as needed.
# -----------------------------------------------------------------------------

# Expose PocketBase admin UI at /_/. Leave disabled (0) in production unless
# you need direct schema access.
R3_ADMIN=0

# Set to 1 after the first run if you do NOT want the demo case manager
# recreated or the superuser re-verified on every restart. Seeding is
# idempotent, but disabling it keeps the logs clean in production.
R3_DISABLE_SEED=0

# Demo case manager. Only created on first run; disable with R3_DISABLE_SEED=1
# after initial deployment if you don't need it.
R3_SEED_CM_EMAIL=cm@r3.aipono.org
R3_SEED_CM_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
R3_SEED_CM_NAME="Demo Case Manager"

# Optional: enable at-rest encryption of SSN/DOB/signatures (requires migration).
# R3_ENCRYPTION_ENABLED=1
# R3_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Optional: read-only Model Context Protocol server.
# R3_MCP_TOKEN=REPLACE_WITH_MCP_BEARER_TOKEN
# R3_MCP_BASE_URL=https://r3.example.org
